diff --git a/core/ngx_snippet.cpp b/core/ngx_snippet.cpp
index 69ae460..b04d3fd 100644
--- a/core/ngx_snippet.cpp
+++ b/core/ngx_snippet.cpp
@@ -430,6 +430,16 @@ bool NgxLoadAndInit(NgxSnippet& s, VkInstance instance, VkPhysicalDevice pd, VkD
                 s.featureFlags = fr.FeatureFlags;
                 s.hdrCapable = (fr.FeatureFlags & NVSDK_NGX_DLSS_Feature_Flags_IsHDR) != 0u;
                 s.hdrActive = wantHdr && s.hdrCapable;
+            } else {
+                // The 310.8 runtime answers this query with FeatureNotSupported (0xbad00005) on
+                // the Vulkan path even where NVAPI is reachable and the feature creates fine.
+                // A refused query says nothing about HDR either way, so leave the door open:
+                // the helper asks for HDR when the swapchain is HDR, the create either takes
+                // the IsHDR flag or refuses it, and a refusal already falls back to 8-bit
+                // (NgxCreatePass, hdrRejected). Gating on this query closed that door for good.
+                s.hdrCapable = true;
+                Log("[reqs] requirements query refused (%#x): HDR capability unknown, will be "
+                    "attempted when asked for", (uint32_t)r);
             }
         }
     }
diff --git a/layer_linux/src/composition.cpp b/layer_linux/src/composition.cpp
index 843e68b..dd399d6 100644
--- a/layer_linux/src/composition.cpp
+++ b/layer_linux/src/composition.cpp
@@ -758,6 +758,12 @@ bool Composition::Prepare(uint32_t width, uint32_t height, VkFormat swapchainFor
         }
     }
 
+    // The transfer only means anything through the float proxy, and that is the form it is
+    // stored in below (`_hdrTransfer = hdrProxy ? hdrTransfer : 0`). Compare it in the same
+    // form, or a PQ10 swapchain with the proxy still 8-bit -- transfer 1 asked, 0 stored --
+    // fails this check on every present and rebuilds every image here once per frame.
+    if (!hdrProxy) hdrTransfer = 0;
+
     if (_width == width && _height == height && _swapchainFormat == swapchainFormat &&
         _modelW == modelW && _modelH == modelH && _linearHdr == linearHdr && _hdrProxy == hdrProxy &&
         _hdrTransfer == hdrTransfer && _scalerFilter == s.downscaler && _frame.image)
